modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CLOUDFLARE_ACCOUNT_ID = "c9eeead91d8e91dba1d3900ac73aa901"
R2_BUCKET_NAME = "aegisrise"
R2_PUBLIC_URL = "https://pub-de58d2c4bb984de6b43283c58a2f7afd.r2.dev"
APP_BASE_URL = "https://aegis-rise.com"
